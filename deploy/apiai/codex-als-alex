#!/bin/bash
# /usr/local/libexec/api-ai/codex-als-alex   root:root 0755   (#2937)
# Einziger Weg von apiai zu alex fuer codex (sudoers erlaubt nur diese Datei).
# Feste Umgebung (env -i), Optionen nur aus einer Liste, Prompt nur ueber stdin.
set -euo pipefail
umask 027
fehler() { echo "codex-als-alex: $*" >&2; exit 64; }
WURZEL=/var/lib/api-ai-cli
BIN=/home/alex/.local/bin/codex

HAUPT=/home/alex/.codex
# #3165: Werkzeuge, die codex als alex nie bekommt (codex features list, 16.11.)
# code_mode_host bleibt erlaubt: image_gen laeuft in dieser codex-Fassung ueber den
# Code-Modus, und der hat ohne Shell keinen Dateizugriff (Kanarienprobe 16.11.).
GESPERRT=(shell_tool unified_exec apps plugins remote_plugin
          browser_use browser_use_external browser_use_full_cdp_access in_app_browser
          computer_use view_image hooks multi_agent skill_mcp_dependency_install)

# Schlankes Text-Home: auth.json ist ein Link auf die Anmeldung im Haupt-Home.
# Erneuert codex das Token, ersetzt es den Link durch eine Datei; die neuere
# Anmeldung gehoert dann zurueck ins Haupt-Home, sonst gilt dort ein
# verbrauchtes Refresh-Token (frueher _codex_text_anmeldung_heilen in api-ai,
# das als apiai nicht mehr in /home/alex kommt).
text_home_heilen() {
  local link="$CH/auth.json" echt
  echt=$(realpath -- "$HAUPT/auth.json")
  if [[ -f "$link" && ! -L "$link" ]]; then
    if [[ "$link" -nt "$echt" ]]; then
      # Nur loeschen, wenn das Zurueckschreiben gelungen ist (Cloud 16.11.:
      # unter ProtectHome=read-only gab cp EROFS, rm loeschte danach die
      # einzige frische Anmeldung). Scheitert es, bleibt sie im Text-Home,
      # codex arbeitet damit weiter, der naechste Aufruf versucht es erneut.
      if cp -p -- "$link" "$echt.neu" && mv -f -- "$echt.neu" "$echt"; then
        rm -f -- "$link"
      else
        rm -f -- "$echt.neu" 2>/dev/null || true
        echo "codex-als-alex: erneuerte Anmeldung nicht nach $echt zurueckgeschrieben, bleibt in $link" >&2
      fi
    else
      rm -f -- "$link"
    fi
  fi
  [[ -e "$link" || -L "$link" ]] || ln -s -- "$HAUPT/auth.json" "$link"
  # Abo-Bilder liegen nach dem Hochladen im Storage; apiai darf hier nicht
  # loeschen (kein Gruppen-Schreibrecht), deshalb raeumt der Wrapper auf.
  find "$CH/generated_images" -type f -mmin +120 -delete 2>/dev/null || true
}

case "${1:-}" in
  haupt) CH=$HAUPT ;;
  text)  CH=$WURZEL/codex-text ;;
  konfig)  # nur Modell und Effort aus dem Top-Level-Block, nie den Rest (MCP-Zugaenge o. ae.)
    awk '/^[[:space:]]*\[/{exit} /^(model|model_reasoning_effort)[[:space:]]*=/{print}' "$HAUPT/config.toml"
    exit 0 ;;
  *) fehler "erstes Argument: haupt, text oder konfig" ;;
esac
shift

gesperrt_aus() {  # features.<name>=false fuer jeden Namen aus GESPERRT
  local f
  for f in "${GESPERRT[@]}"; do [[ "$1" == "features.$f=false" ]] && return 0; done
  return 1
}
erlaubt_c() {
  gesperrt_aus "$1" && return 0
  case "$1" in
    features.shell_tool=false|features.unified_exec=false|features.code_mode_host=false|\
    features.apps=false|features.plugins=false|include_environment_context=false|\
    include_permissions_instructions=false|include_apps_instructions=false|\
    model_instructions_file=/var/www/api-ai.arkturian.com/ai/data/codex_text_anweisung.md) return 0 ;;
    model_reasoning_effort=*) [[ "${1#*=}" =~ ^[a-z]{1,12}$ ]] ;;
    *) return 1 ;;
  esac
}
pfad_ok() {
  local p
  p=$(realpath -m -- "$1")
  [[ "$p" == "$WURZEL"/eingang/* || "$p" == "$WURZEL"/arbeit/* ]]
}

args=("$@"); n=${#args[@]}
if [[ $n -eq 1 && "${args[0]}" == "--version" ]]; then
  :
elif [[ $n -eq 2 && "${args[0]}" == debug && "${args[1]}" == models ]]; then
  :
elif [[ $n -ge 2 && "${args[0]}" == exec ]]; then
  i=1; ende=0; sandbox=0
  while (( i < n )); do
    a=${args[i]}
    if (( ende )); then
      [[ "$a" == "-" && $((i+1)) -eq n ]] || fehler "nach -- nur noch -"
      i=$((i+1)); continue
    fi
    case "$a" in
      --json|--skip-git-repo-check|--ephemeral) ;;
      -s) i=$((i+1)); [[ "${args[i]:-}" == read-only ]] || fehler "-s nur read-only"; sandbox=1 ;;
      -C) i=$((i+1)); pfad_ok "${args[i]:-}" || fehler "-C ausserhalb von $WURZEL/arbeit" ;;
      -i) i=$((i+1)); pfad_ok "${args[i]:-}" || fehler "-i ausserhalb von $WURZEL/eingang" ;;
      -m|--model) i=$((i+1)); [[ "${args[i]:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$ ]] || fehler "Modellname" ;;
      -c) i=$((i+1)); erlaubt_c "${args[i]:-}" || fehler "-c ${args[i]:-} nicht erlaubt" ;;
      --) ende=1 ;;
      -) [[ $((i+1)) -eq n ]] || fehler "- nur am Ende" ;;
      *) fehler "Option nicht erlaubt: $a" ;;
    esac
    i=$((i+1))
  done
  [[ "${args[n-1]}" == "-" ]] || fehler "Prompt nur ueber stdin (-)"
  # Ohne -s gilt immer read-only, auch im Betreiber-Modus mit Werkzeugen.
  (( sandbox )) || args=(exec -s read-only "${args[@]:1}")
  # #3165: Werkzeuge immer aus, in jedem Modus. read-only verhindert nur das
  # Schreiben; mit Shell liest codex als alex jede Datei von alex (~/.ssh,
  # .env), mit Plugins erreicht es alex' Gmail und GitHub, mit Browser oder
  # view_image liest es file://-Adressen bzw. Bilder aus /home/alex. Gesperrt
  # wird vor den Aufrufer-Optionen; erlaubt_c laesst fuer diese Schluessel
  # nur =false zu, ein spaeteres -c schaltet sie also nicht wieder ein.
  # image_generation bleibt an (Abo-Bilder).
  sperren=()
  for f in "${GESPERRT[@]}"; do sperren+=(-c "features.$f=false"); done
  args=(exec "${sperren[@]}" "${args[@]:1}")
else
  fehler "nur --version, debug models oder exec"
fi

[[ "$CH" == "$HAUPT" ]] || text_home_heilen

exec env -i HOME=/home/alex PATH=/home/alex/.local/bin:/usr/local/bin:/usr/bin:/bin \
  NO_COLOR=1 LANG=C.UTF-8 CODEX_HOME="$CH" "$BIN" "${args[@]}"
